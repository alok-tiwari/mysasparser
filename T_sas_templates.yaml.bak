macro_variable_processing:
  template: |
    class MacroVariableProcessor:
        """Enhanced macro variable processing."""
        def __init__(self):
            self.variables = 
            self.functions = {
                'upcase': str.upper,
                'lowcase': str.lower,
                'substr': lambda x, *args: x[args[0]-1:args[0]-1+args[1]],
                'trim': str.strip,
                'left': str.lstrip,
                'right': str.rstrip
            }
        
        def resolve(self, text: str) -> str:
            """Resolve macro variables in text."""
            result = text
            # Find all &variable references
            pattern = r'&([a-zA-Z_][a-zA-Z0-9_]*)'
            matches = re.finditer(pattern, text)
            for match in matches:
                var_name = match.group(1)
                if var_name in self.variables:
                    result = result.replace("&".format(var_name), str(self.variables[var_name]))
            return result
        
        def evaluate(self, expression: str) -> Any:
            """Evaluate macro expressions."""
            # Replace macro variables
            resolved = self.resolve(expression)
            # Evaluate Python expression
            try:
                return eval(resolved, {"__builtins__": {}}, self.functions)
            except:
                return expression

output_handling_enhanced:
  template: |
    class OutputManager:
        """Enhanced output handling."""
        def __init__(self):
            self.destinations = 
            self.styles = 
            self.current_style = None
        
        def add_destination(self, name: str, path: str, type: str = 'html'):
            """Add output destination."""
            self.destinations[name] = {
                'path': path,
                'type': type,
                'active': True
            }
        
        def close_destination(self, name: str):
            """Close output destination."""
            if name in self.destinations:
                self.destinations[name]['active'] = False
        
        def set_style(self, style_dict: Dict):
            """Set output style."""
            self.current_style = style_dict
        
        def write_output(self, content: Any, destination: str = None):
            """Write content to destination."""
            if destination and destination in self.destinations:
                dest = self.destinations[destination]
                if dest['active']:
                    if dest['type'] == 'html':
                        self._write_html(content, dest['path'])
                    elif dest['type'] == 'pdf':
                        self._write_pdf(content, dest['path'])
                    elif dest['type'] == 'rtf':
                        self._write_rtf(content, dest['path'])
        
        def _write_html(self, content, path):
            """Write HTML output."""
            if isinstance(content, pd.DataFrame):
                content.to_html(path, **self.current_style or )
            else:
                with open(path, 'w') as f:
                    f.write(str(content))

# Add these new templates

# PROC TRANSPOSE template
proc_transpose:
  template: |
    {% if dataset %}
    # Transpose {{ dataset }}
    {% if by_vars %}
    grouped = {{ dataset }}_df.groupby([{{ by_vars|join(', ') }}])
    {% endif %}
    
    {% if var_vars %}
    result_df = {{ dataset }}_df.pivot(
        {% if by_vars %}index={{ by_vars|join(', ') }},{% endif %}
        {% if id_var %}columns='{{ id_var }}',{% endif %}
        values=[{{ var_vars|join(', ') }}]
    )
