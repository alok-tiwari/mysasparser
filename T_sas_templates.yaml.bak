# PROC FREQ template
proc_freq:
  template: |
    {% if dataset %}
    # Frequency analysis for {{ dataset }}
    {% if tables %}
    {% for table in tables %}
    # Frequency table for {{ table }}
    freq_table = pd.crosstab(
        {{ dataset }}_df['{{ table.rows }}'],
        {% if table.cols %}{{ dataset }}_df['{{ table.cols }}'],{% endif %}
        margins=True
    )
    
    {% if table.chisq %}
    from scipy.stats import chi2_contingency
    chi2, p_value, dof, expected = chi2_contingency(freq_table)
    print("\nChi-square test results:")
    print("Chi2 statistic: {:.4f}".format(chi2))
    print("p-value: {:.4f}".format(p_value))
    {% endif %}
    {% endfor %}
    {% endif %}
    {% endif %}

# PROC ANOVA template
proc_anova:
  template: |
    {% if dataset and dependent and class_vars %}
    # ANOVA analysis
    from scipy import stats
    import statsmodels.api as sm
    from statsmodels.stats.multicomp import pairwise_tukeyhsd
    
    # Prepare data
    model_data = {{ dataset }}_df.dropna(subset=['{{ dependent }}'] + [{{ class_vars|join(', ') }}])
    
    # One-way ANOVA
    groups = [group for _, group in model_data.groupby('{{ class_vars[0] }}')['{{ dependent }}']]
    f_stat, p_value = stats.f_oneway(*groups)
    
    print("\nOne-way ANOVA Results:")
    print("F-statistic: {:.4f}".format(f_stat))
    print("p-value: {:.4f}".format(p_value))
    
    # Post-hoc Tukey test
    tukey = pairwise_tukeyhsd(
        model_data['{{ dependent }}'],
        model_data['{{ class_vars[0] }}']
    )
    print("\nTukey's HSD Test Results:")
    print(tukey)
    
    {% if plots %}
    import seaborn as sns
    import matplotlib.pyplot as plt
    
    # Box plot
    plt.figure(figsize=(10, 6))
    sns.boxplot(x='{{ class_vars[0] }}', y='{{ dependent }}', data=model_data)
    plt.title('Distribution by Group')
    plt.show()
    {% endif %}
    {% endif %}

# PROC GLM template
proc_glm:
  template: |
    {% if dataset and dependent and independent %}
    # General Linear Model analysis
    import statsmodels.api as sm
    import numpy as np
    
    # Prepare data
    X = {{ dataset }}_df[[{{ independent|join(', ') }}]]
    {% if class_vars %}
    # Add dummy variables for categorical predictors
    X = pd.get_dummies({{ dataset }}_df[[{{ independent|join(', ') }}, {{ class_vars|join(', ') }}]], 
                      columns=[{{ class_vars|join(', ') }}])
    {% endif %}
    X = sm.add_constant(X)
    y = {{ dataset }}_df['{{ dependent }}']
    
    # Fit model
    model = sm.OLS(y, X).fit()
    
    print("\nGLM Results:")
    print(model.summary())
    
    {% if plots %}
    import matplotlib.pyplot as plt
    
    # Diagnostic plots
    fig, axes = plt.subplots(2, 2, figsize=(12, 10))
    
    # Residuals vs Fitted
    axes[0,0].scatter(model.fittedvalues, model.resid)
    axes[0,0].axhline(y=0, color='r', linestyle='--')
    axes[0,0].set_xlabel('Fitted values')
    axes[0,0].set_ylabel('Residuals')
    axes[0,0].set_title('Residuals vs Fitted')
    
    # Q-Q plot
    sm.graphics.qqplot(model.resid, line='45', fit=True, ax=axes[0,1])
    axes[0,1].set_title('Q-Q Plot')
    
    # Scale-Location
    axes[1,0].scatter(model.fittedvalues, np.sqrt(np.abs(model.resid)))
    axes[1,0].set_xlabel('Fitted values')
    axes[1,0].set_ylabel('Sqrt(|Residuals|)')
    axes[1,0].set_title('Scale-Location')
    
    # Leverage plot
    sm.graphics.influence_plot(model, ax=axes[1,1])
    
    plt.tight_layout()
    plt.show()
    {% endif %}
    {% endif %}

# PROC MIXED template
proc_mixed:
  template: |
    {% if dataset and dependent and fixed_effects %}
    # Mixed Effects Model analysis
    import statsmodels.api as sm
    import statsmodels.formula.api as smf
    
    # Construct formula
    fixed_effects_str = ' + '.join([{{ fixed_effects|join(' + ') }}])
    {% if random_effects %}
    random_effects_str = ' + '.join([{{ random_effects|join(' + ') }}])
    formula = "{{ dependent }} ~ " + fixed_effects_str + " + (1|" + random_effects_str + ")"
    {% else %}
    formula = "{{ dependent }} ~ " + fixed_effects_str
    {% endif %}
    
    # Fit mixed model
    model = smf.mixedlm(formula, data={{ dataset }}_df, groups={{ dataset }}_df['{{ groups }}'])
    results = model.fit()
    
    print("\nMixed Model Results:")
    print(results.summary())
    
    {% if plots %}
    import matplotlib.pyplot as plt
    import seaborn as sns
    
    # Random effects plot
    plt.figure(figsize=(10, 6))
    ranef_df = pd.DataFrame(results.random_effects)
    sns.boxplot(data=ranef_df)
    plt.title('Random Effects Distribution')
    plt.show()
    {% endif %}
    {% endif %}

# PROC LOGISTIC template
proc_logistic:
  template: |
    {% if dataset and dependent and independent %}
    # Logistic Regression analysis
    from sklearn.linear_model import LogisticRegression
    from sklearn.metrics import classification_report, roc_curve, auc
    
    # Prepare data
    X = {{ dataset }}_df[[{{ independent|join(', ') }}]]
    y = {{ dataset }}_df['{{ dependent }}']
    
    # Fit model
    model = LogisticRegression(random_state=42)
    model.fit(X, y)
    
    # Predictions
    y_pred = model.predict(X)
    y_pred_proba = model.predict_proba(X)[:, 1]
    
    print("\nLogistic Regression Results:")
    print("\nModel Coefficients:")
    for var, coef in zip([{{ independent|join(', ') }}], model.coef_[0]):
        print(": {:.4f}".format(var, coef))
    print("\nIntercept: {:.4f}".format(model.intercept_[0]))
    
    print("\nClassification Report:")
    print(classification_report(y, y_pred))
    
    {% if plots %}
    import matplotlib.pyplot as plt
    
    # ROC curve
    fpr, tpr, _ = roc_curve(y, y_pred_proba)
    roc_auc = auc(fpr, tpr)
    
    plt.figure(figsize=(8, 6))
    plt.plot(fpr, tpr, color='darkorange', lw=2, label='ROC curve (AUC = {:.2f})'.format(roc_auc))
    plt.plot([0, 1], [0, 1], color='navy', lw=2, linestyle='--')
    plt.xlim([0.0, 1.0])
    plt.ylim([0.0, 1.05])
    plt.xlabel('False Positive Rate')
    plt.ylabel('True Positive Rate')
    plt.title('Receiver Operating Characteristic (ROC) Curve')
    plt.legend(loc="lower right")
    plt.show()
    {% endif %}
    {% endif %}

# PROC CLUSTER template
proc_cluster:
  template: |
    {% if dataset and variables %}
    # Hierarchical Clustering analysis
    from scipy.cluster.hierarchy import dendrogram, linkage
    from sklearn.preprocessing import StandardScaler
    
    # Prepare and scale data
    X = {{ dataset }}_df[[{{ variables|join(', ') }}]]
    X_scaled = StandardScaler().fit_transform(X)
    
    # Perform hierarchical clustering
    linkage_matrix = linkage(X_scaled, method='ward')
    
    {% if n_clusters %}
    from sklearn.cluster import AgglomerativeClustering
    
    # Create clusters
    cluster = AgglomerativeClustering(n_clusters={{ n_clusters }})
    cluster_labels = cluster.fit_predict(X_scaled)
    
    # Add cluster labels to dataset
    {{ dataset }}_df['Cluster'] = cluster_labels
    
    print("\nCluster Sizes:")
    print({{ dataset }}_df['Cluster'].value_counts())
    
    print("\nCluster Means:")
    print({{ dataset }}_df.groupby('Cluster')[[{{ variables|join(', ') }}]].mean())
    {% endif %}
    
    {% if plots %}
    import matplotlib.pyplot as plt
    import seaborn as sns
    
    # Dendrogram
    plt.figure(figsize=(10, 7))
    dendrogram(linkage_matrix)
    plt.title('Hierarchical Clustering Dendrogram')
    plt.xlabel('Sample Index')
    plt.ylabel('Distance')
    plt.show()
    
    # Cluster visualization (if 2 or 3 variables)
    if len([{{ variables|join(', ') }}]) == 2:
        plt.figure(figsize=(8, 6))
        sns.scatterplot(data={{ dataset }}_df, 
                       x='{{ variables[0] }}', 
                       y='{{ variables[1] }}',
                       hue='Cluster',
                       palette='deep')
        plt.title('Cluster Plot')
        plt.show()
    {% endif %}
    {% endif %}

# PROC FACTOR template
proc_factor:
  template: |
    {% if dataset and variables %}
    # Factor Analysis
    from factor_analyzer import FactorAnalyzer
    from factor_analyzer.factor_analyzer import calculate_kmo
    import numpy as np
    
    # Prepare data
    X = {{ dataset }}_df[[{{ variables|join(', ') }}]]
    
    # KMO test
    kmo_all, kmo_model = calculate_kmo(X)
    print('KMO score: {:.3f}'.format(kmo_model))
    
    # Determine number of factors
    fa = FactorAnalyzer(rotation=None, n_factors=X.shape[1])
    fa.fit(X)
    ev, v = fa.get_eigenvalues()
    n_factors = sum(ev > 1)
    
    # Perform factor analysis
    fa = FactorAnalyzer(rotation='varimax', n_factors=n_factors)
    fa.fit(X)
    
    # Get factor loadings
    loadings = pd.DataFrame(
        fa.loadings_,
        columns=['Factor'.format(i+1) for i in range(n_factors)],
        index=[{{ variables|join(', ') }}]
    )
    
    print('\nFactor Loadings:')
    print(loadings)
    
    # Variance explained
    variance = pd.DataFrame(
        fa.get_factor_variance(),
        columns=['SS Loadings', 'Proportion Var', 'Cumulative Var']
    )
    print('\nVariance Explained:')
    print(variance)
    
    {% if plots %}
    import matplotlib.pyplot as plt
    import seaborn as sns
    
    # Scree plot
    plt.figure(figsize=(10, 6))
    plt.plot(range(1, len(ev) + 1), ev)
    plt.plot([1, len(ev)], [1, 1], '--')
    plt.title('Scree Plot')
    plt.xlabel('Factors')
    plt.ylabel('Eigenvalue')
    plt.show()
    
    # Factor loadings heatmap
    plt.figure(figsize=(10, 8))
    sns.heatmap(loadings, annot=True, cmap='coolwarm', center=0)
    plt.title('Factor Loadings Heatmap')
    plt.show()
    {% endif %}
    {% endif %}

# PROC DISCRIM template
proc_discrim:
  template: |
    {% if dataset and variables and class_var %}
    # Discriminant Analysis
    from sklearn.discriminant_analysis import LinearDiscriminantAnalysis
    from sklearn.model_selection import cross_val_score
    from sklearn.metrics import classification_report, confusion_matrix
    
    # Prepare data
    X = {{ dataset }}_df[[{{ variables|join(', ') }}]]
    y = {{ dataset }}_df['{{ class_var }}']
    
    # Fit LDA
    lda = LinearDiscriminantAnalysis()
    lda.fit(X, y)
    
    # Cross-validation
    cv_scores = cross_val_score(lda, X, y, cv=5)
    print('Cross-validation scores:', cv_scores)
    print('Mean CV score: {:.4f}'.format(cv_scores.mean()))
    
    # Classification results
    y_pred = lda.predict(X)
    print('\nClassification Report:')
    print(classification_report(y, y_pred))
    
    {% if plots %}
    import matplotlib.pyplot as plt
    import seaborn as sns
    
    # Confusion matrix
    plt.figure(figsize=(8, 6))
    cm = confusion_matrix(y, y_pred)
    sns.heatmap(cm, annot=True, fmt='d', cmap='Blues')
    plt.title('Confusion Matrix')
    plt.xlabel('Predicted')
    plt.ylabel('Actual')
    plt.show()
    
    # If 2 variables, plot decision boundary
    if len([{{ variables|join(', ') }}]) == 2:
        plt.figure(figsize=(10, 6))
        plot_decision_boundary(lda, X, y)
        plt.title('LDA Decision Boundary')
        plt.show()
    {% endif %}
    {% endif %}

# PROC PRINCOMP template
proc_princomp:
  template: |
    {% if dataset and variables %}
    # Principal Components Analysis
    from sklearn.decomposition import PCA
    from sklearn.preprocessing import StandardScaler
    
    # Prepare and scale data
    X = {{ dataset }}_df[[{{ variables|join(', ') }}]]
    X_scaled = StandardScaler().fit_transform(X)
    
    # Perform PCA
    pca = PCA()
    pca_result = pca.fit_transform(X_scaled)
    
    # Calculate explained variance
    var_exp = pca.explained_variance_ratio_
    cum_var_exp = np.cumsum(var_exp)
    
    print('\nExplained Variance Ratio:')
    for i, var in enumerate(var_exp):
        print('PC: {:.4f} ({:.4f} cumulative)'.format(i+1, var, cum_var_exp[i]))
    
    # Component loadings
    loadings = pd.DataFrame(
        pca.components_.T,
        columns=['PC'.format(i+1) for i in range(len(var_exp))],
        index=[{{ variables|join(', ') }}]
    )
    print('\nComponent Loadings:')
    print(loadings)
    
    {% if plots %}
    import matplotlib.pyplot as plt
    import seaborn as sns
    
    # Scree plot
    plt.figure(figsize=(10, 6))
    plt.plot(range(1, len(var_exp) + 1), var_exp, 'bo-')
    plt.plot(range(1, len(var_exp) + 1), cum_var_exp, 'ro-')
    plt.title('Scree Plot')
    plt.xlabel('Principal Component')
    plt.ylabel('Proportion of Variance Explained')
    plt.legend(['Individual', 'Cumulative'])
    plt.show()
    
    # Biplot (if 2 components)
    if len([{{ variables|join(', ') }}]) >= 2:
        plt.figure(figsize=(10, 8))
        plt.scatter(pca_result[:, 0], pca_result[:, 1])
        for i, var in enumerate([{{ variables|join(', ') }}]):
            plt.arrow(0, 0, 
                     loadings.iloc[i, 0] * max(pca_result[:, 0]),
                     loadings.iloc[i, 1] * max(pca_result[:, 1]),
                     color='r', alpha=0.5)
            plt.text(loadings.iloc[i, 0] * max(pca_result[:, 0]) * 1.15,
                    loadings.iloc[i, 1] * max(pca_result[:, 1]) * 1.15,
                    ''.format(var))
        plt.xlabel('First Principal Component')
        plt.ylabel('Second Principal Component')
        plt.title('PCA Biplot')
        plt.show()
    {% endif %}
    {% endif %}

# PROC MANOVA template
proc_manova:
  template: |
    {% if dataset and dependent_vars and class_vars %}
    # Multivariate Analysis of Variance
    from statsmodels.multivariate.manova import MANOVA
    import numpy as np
    import pandas as pd
    
    # Prepare data
    X = {{ dataset }}_df[[{{ dependent_vars|join(', ') }}]]
    grouping = {{ dataset }}_df['{{ class_vars[0] }}']
    
    # Fit MANOVA
    manova = MANOVA.from_formula('{{ dependent_vars|join(' + ') }} ~ {{ class_vars[0] }}', 
                                data={{ dataset }}_df)
    result = manova.mv_test()
    
    print("\nMANOVA Results:")
    print(result.summary())
    
    # Univariate follow-up
    print("\nUnivariate Follow-up Tests:")
    for dv in [{{ dependent_vars|join(', ') }}]:
        from scipy import stats
        groups = [group for _, group in {{ dataset }}_df.groupby('{{ class_vars[0] }}')[dv]]
        f_stat, p_val = stats.f_oneway(*groups)
        print("\n:".format(dv))
        print("F-statistic: {:.4f}".format(f_stat))
        print("p-value: {:.4f}".format(p_val))
    
    {% if plots %}
    import matplotlib.pyplot as plt
    import seaborn as sns
    
    # Box plots for each dependent variable
    fig, axes = plt.subplots(1, len([{{ dependent_vars|join(', ') }}]), 
                            figsize=(15, 5))
    for i, dv in enumerate([{{ dependent_vars|join(', ') }}]):
        sns.boxplot(x='{{ class_vars[0] }}', y=dv, 
                   data={{ dataset }}_df, ax=axes[i])
        axes[i].set_title(dv)
    plt.tight_layout()
    plt.show()
    {% endif %}
    {% endif %}

# PROC TIMESERIES template
proc_timeseries:
  template: |
    {% if dataset and time_var and value_var %}
    # Time Series Analysis
    from statsmodels.tsa.seasonal import seasonal_decompose
    from statsmodels.tsa.stattools import adfuller
    from statsmodels.tsa.arima.model import ARIMA
    import pandas as pd
    
    # Prepare time series data
    ts_data = {{ dataset }}_df.set_index('{{ time_var }}')['{{ value_var }}']
    
    # Decomposition
    decomposition = seasonal_decompose(ts_data, period={{ period|default(12) }})
    
    # Stationarity test
    adf_test = adfuller(ts_data)
    print('\nTime Series Results:')
    print('ADF Statistic: {:.4f}'.format(adf_test[0]))
    print('p-value: {:.4f}'.format(adf_test[1]))
    
    # ARIMA modeling
    model = ARIMA(ts_data, order=({{ p|default(1) }}, {{ d|default(1) }}, {{ q|default(1) }}))
    results = model.fit()
    print('\nARIMA Model Summary:')
    print(results.summary())
    
    # Forecasting
    forecast = results.forecast(steps={{ forecast_steps|default(12) }})
    
    {% if plots %}
    import matplotlib.pyplot as plt
    
    # Decomposition plots
    fig, (ax1, ax2, ax3, ax4) = plt.subplots(4, 1, figsize=(12, 10))
    decomposition.observed.plot(ax=ax1)
    ax1.set_title('Observed')
    decomposition.trend.plot(ax=ax2)
    ax2.set_title('Trend')
    decomposition.seasonal.plot(ax=ax3)
    ax3.set_title('Seasonal')
    decomposition.resid.plot(ax=ax4)
    ax4.set_title('Residual')
    plt.tight_layout()
    plt.show()
    
    # Forecast plot
    plt.figure(figsize=(12, 6))
    ts_data.plot(label='Observed')
    forecast.plot(label='Forecast')
    plt.title('Time Series Forecast')
    plt.legend()
    plt.show()
    {% endif %}
    {% endif %}

# PROC SURVIVAL template
proc_survival:
  template: |
    {% if dataset and time_var and event_var %}
    # Survival Analysis
    from lifelines import KaplanMeierFitter
    from lifelines import CoxPHFitter
    
    # Prepare data
    time = {{ dataset }}_df['{{ time_var }}']
    event = {{ dataset }}_df['{{ event_var }}']
    
    # Kaplan-Meier estimation
    kmf = KaplanMeierFitter()
    kmf.fit(time, event, label='Overall')
    
    print('\nKaplan-Meier Model Summary:')
    print(kmf.print_summary())
    
    {% if covariates %}
    # Cox Proportional Hazards
    cph = CoxPHFitter()
    cph.fit({{ dataset }}_df[[
        '{{ time_var }}', 
        '{{ event_var }}',
        {{ covariates|join(', ') }}
    ]], 
    duration_col='{{ time_var }}',
    event_col='{{ event_var }}')
    
    print('\nCox Proportional Hazards Model:')
    print(cph.print_summary())
    {% endif %}
    
    {% if plots %}
    import matplotlib.pyplot as plt
    
    # Survival curve
    plt.figure(figsize=(10, 6))
    kmf.plot()
    plt.title('Kaplan-Meier Survival Curve')
    plt.show()
    
    {% if strata_var %}
    # Stratified survival curves
    fig, ax = plt.subplots(figsize=(10, 6))
    for value in {{ dataset }}_df['{{ strata_var }}'].unique():
        mask = {{ dataset }}_df['{{ strata_var }}'] == value
        kmf_strata = KaplanMeierFitter()
        kmf_strata.fit(
            time[mask], 
            event[mask],
            label='='.format('{{ strata_var }}', value)
        )
        kmf_strata.plot(ax=ax)
    plt.title('Stratified Survival Curves')
    plt.show()
    {% endif %}
    
    {% if covariates %}
    # Cox model plots
    cph.plot_partial_effects('{{ covariates[0] }}')
    plt.title('Partial Effect Plot')
    plt.show()
    {% endif %}
    {% endif %}
    {% endif %}

# PROC CANDISC template
proc_candisc:
  template: |
    {% if dataset and variables and class_var %}
    # Canonical Discriminant Analysis
    from sklearn.discriminant_analysis import LinearDiscriminantAnalysis
    from sklearn.preprocessing import StandardScaler
    
    # Prepare data
    X = {{ dataset }}_df[[{{ variables|join(', ') }}]]
    y = {{ dataset }}_df['{{ class_var }}']
    
    # Scale features
    X_scaled = StandardScaler().fit_transform(X)
    
    # Fit LDA for canonical analysis
    lda = LinearDiscriminantAnalysis()
    X_canon = lda.fit_transform(X_scaled, y)
    
    # Calculate canonical correlations
    canon_corr = np.sqrt(lda.explained_variance_ratio_)
    
    print('\nCanonical Correlations:')
    for i, corr in enumerate(canon_corr):
        print('Can: {:.4f}'.format(i+1, corr))
    
    # Structure matrix
    structure = np.corrcoef(X_scaled.T, X_canon.T)[:len(X.columns), -len(canon_corr):]
    struct_df = pd.DataFrame(
        structure,
        index=[{{ variables|join(', ') }}],
        columns=['Can'.format(i+1) for i in range(len(canon_corr))]
    )
    
    print('\nStructure Matrix:')
    print(struct_df)
    
    {% if plots %}
    import matplotlib.pyplot as plt
    import seaborn as sns
    
    # Canonical variate plot (first two variates)
    if X_canon.shape[1] >= 2:
        plt.figure(figsize=(10, 6))
        scatter = plt.scatter(X_canon[:, 0], X_canon[:, 1], c=y)
        plt.xlabel('First Canonical Variable')
        plt.ylabel('Second Canonical Variable')
        plt.title('Canonical Discriminant Analysis')
        plt.legend(*scatter.legend_elements(), title='Classes')
        plt.show()
    
    # Structure correlations heatmap
    plt.figure(figsize=(10, 8))
    sns.heatmap(struct_df, annot=True, cmap='coolwarm', center=0)
    plt.title('Structure Matrix Heatmap')
    plt.show()
    {% endif %}
    {% endif %}

