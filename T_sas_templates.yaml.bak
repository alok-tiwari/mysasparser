    class ExtendedFormats:
        @staticmethod
        def zd(value: int, width: int) -> str:
            """Implement ZD. format (zero decimal)."""
            return "{value:0d}".format(width)
            
        @staticmethod
        def pd(value: int, width: int) -> str:
            """Implement PD. format (packed decimal)."""
            return "{value:+0d}".format(width)
            
        @staticmethod
