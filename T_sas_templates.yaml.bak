    class SASValidator:
        """Validation rules for SAS components."""
        @staticmethod
        def validate_dataset_name(name: str) -> bool:
            """Validate SAS dataset name."""
            if not name:
                return False
            pattern = re.compile(r'^[a-zA-Z_][a-zA-Z0-9_]*$')
            return bool(pattern.match(name)) and len(name) <= 32
        
        @staticmethod
        def validate_variable_name(name: str) -> bool:
            """Validate SAS variable name."""
            if not name:
                return False
            pattern = re.compile(r'^[a-zA-Z_][a-zA-Z0-9_]*$')
            return bool(pattern.match(name)) and len(name) <= 32
        
        @staticmethod
        def validate_format(format_str: str) -> bool:
            """Validate SAS format specification."""
            pattern = re.compile(r'^(\$?[A-Za-z]+)(\d+)\.?(\d+)?$')
            return bool(pattern.match(format_str))
        
        @staticmethod
        def validate_date_value(value: Any) -> bool:
            """Validate date value."""
            if isinstance(value, (datetime, date)):
                return True
            try:
                pd.to_datetime(value)
                return True
            except:
                return False

utility_functions:
  template: |
    class SASUtilities:
        @staticmethod
        def compress(string: str, chars: str = None, modifiers: str = None) -> str:
            """COMPRESS function."""
            if not string:
                return ""
            
            if chars is None and modifiers is None:
                return string.replace(" ", "")
            
            if modifiers:
                if 'd' in modifiers.lower():  # digits
                    string = ''.join(c for c in string if not c.isdigit())
                if 'a' in modifiers.lower():  # letters
                    string = ''.join(c for c in string if not c.isalpha())
                if 's' in modifiers.lower():  # spaces
                    string = ''.join(c for c in string if not c.isspace())
            
            if chars:
                string = ''.join(c for c in string if c not in chars)
            
            return string
        
        @staticmethod
        def tranwrd(string: str, from_str: str, to_str: str) -> str:
            """TRANWRD function."""
            if not string or not from_str:
                return string
            return string.replace(from_str, to_str)
        
        @staticmethod
        def find(string: str, substring: str, start: int = 1) -> int:
            """FIND function."""
            if not string or not substring:
                return 0
            try:
                # Convert to 0-based indexing for Python
                pos = string.index(substring, start - 1)
                # Convert back to 1-based indexing for SAS compatibility
                return pos + 1
            except ValueError:
                return 0
        
        @staticmethod
        def soundex(string: str) -> str:
            """SOUNDEX function."""
            if not string:
                return ""
            
            # Basic implementation of the Soundex algorithm
            string = string.upper()
            soundex = string[0]
            
            # Soundex digit mappings
            mappings = {
                'BFPV': '1',
                'CGJKQSXZ': '2',
                'DT': '3',
                'L': '4',
                'MN': '5',
                'R': '6'
            }
            
            # Convert remaining letters to digits
            for char in string[1:]:
                for key in mappings:
                    if char in key:
                        soundex += mappings[key]
                        break
            
            # Remove duplicates and pad/truncate to 4 characters
            soundex = soundex[0] + ''.join(c for i, c in enumerate(soundex[1:])
                                         if i == 0 or c != soundex[1:][i-1])
            return (soundex + '0' * 4)[:4]

