            """Generate datetime range with specified format."""
            dates = pd.date_range(start, end)
            return [d.strftime(format) for d in dates] 

macro_processing_extensions:
  template: |
    class MacroProcessor:
        def __init__(self):
            self.global_symbols = 
            self.local_symbols = []
            self.macro_functions = 
            
        def define_macro(self, name: str, params: List[str], body: str):
            """Define a macro function."""
            self.macro_functions[name] = {
                'params': params,
                'body': body
            }
            
        def resolve_macro_variable(self, name: str) -> str:
            """Resolve macro variable value."""
            # Check local scope first
            for scope in reversed(self.local_symbols):
                if name in scope:
                    return scope[name]
            # Then check global scope
            return self.global_symbols.get(name)
            
        def execute_macro(self, name: str, args: Dict[str, Any]) -> str:
            """Execute a macro function."""
            if name not in self.macro_functions:
                raise ValueError("Macro  not found".format(name))
                
            macro = self.macro_functions[name]
            # Create new local scope
            local_scope = dict(zip(macro['params'], args))
            self.local_symbols.append(local_scope)
            
            try:
                # Execute macro body
                result = self._execute_macro_body(macro['body'])
                return result
            finally:
                # Remove local scope
                self.local_symbols.pop() 

proc_extensions:
  tabulate:
    template: |
      class TabulateBuilder:
          """Handle complex tabulations like PROC TABULATE."""
          def __init__(self, df: pd.DataFrame):
              self.df = df
              self.page_vars = []
              self.row_vars = []
              self.col_vars = []
              self.statistics = []
          
          def add_page_var(self, var: str):
              self.page_vars.append(var)
          
          def add_row_var(self, var: str):
              self.row_vars.append(var)
          
          def add_col_var(self, var: str):
              self.col_vars.append(var)
          
          def add_statistic(self, var: str, stat: str):
              self.statistics.append((var, stat))
          
          def generate(self) -> pd.DataFrame:
              """Generate tabulation."""
              if not self.row_vars and not self.col_vars:
                  raise ValueError("Must specify at least one row or column variable")
              
              # Create grouping
              group_vars = self.row_vars + self.col_vars
              if self.page_vars:
                  group_vars = self.page_vars + group_vars
              
              # Calculate statistics
              aggs = 
              for var, stat in self.statistics:
                  aggs["{var}_".format(stat)] = pd.NamedAgg(column=var, aggfunc=stat)
              
              result = self.df.groupby(group_vars).agg(**aggs)
              
              # Reshape if necessary
              if self.col_vars:
                  result = result.unstack(self.col_vars)
              
              return result

  transpose:
    template: |
      class TransposeBuilder:
          """Handle data transposition like PROC TRANSPOSE."""
          def __init__(self, df: pd.DataFrame):
              self.df = df
              self.id_vars = []
              self.value_vars = []
              self.name_prefix = ""
          
          def set_id_vars(self, vars: List[str]):
              self.id_vars = vars
          
          def set_value_vars(self, vars: List[str]):
              self.value_vars = vars
          
          def set_name_prefix(self, prefix: str):
              self.name_prefix = prefix
          
          def transpose(self) -> pd.DataFrame:
              """Perform transposition."""
              if not self.value_vars:
                  self.value_vars = [col for col in self.df.columns 
                                   if col not in self.id_vars]
              
              # Melt the dataframe
              melted = pd.melt(self.df, 
                             id_vars=self.id_vars,
                             value_vars=self.value_vars)
              
              # Pivot the melted data
              result = melted.pivot(index=self.id_vars[0] if self.id_vars else None,
                                  columns='variable',
                                  values='value')
              
              # Rename columns if prefix specified
              if self.name_prefix:
                  result.columns = ["{self.name_prefix}".format(i+1) 
                                  for i in range(len(result.columns))]
              
              return result

  compare:
    template: |
      class CompareBuilder:
          """Compare datasets like PROC COMPARE."""
          def __init__(self, base_df: pd.DataFrame, comp_df: pd.DataFrame):
              self.base_df = base_df
              self.comp_df = comp_df
              self.by_vars = []
              self.compare_vars = []
          
          def set_by_vars(self, vars: List[str]):
              self.by_vars = vars
          
          def set_compare_vars(self, vars: List[str]):
              self.compare_vars = vars
          
          def compare(self) -> Dict[str, Any]:
              """Perform comparison."""
              results = {
                  'structure': self._compare_structure(),
                  'values': self._compare_values(),
                  'summary': 
              }
              
              # Calculate summary statistics
              results['summary'] = {
                  'matching_rows': self.matching_rows,
                  'base_only_rows': self.base_only_rows,
                  'comp_only_rows': self.comp_only_rows,
                  'differing_values': self.differing_values
              }
              
              return results
          
          def _compare_structure(self) -> Dict[str, List[str]]:
              """Compare dataset structures."""
              base_cols = set(self.base_df.columns)
              comp_cols = set(self.comp_df.columns)
              
              return {
                  'matching_vars': list(base_cols & comp_cols),
                  'base_only_vars': list(base_cols - comp_cols),
                  'comp_only_vars': list(comp_cols - base_cols)
              }
          
          def _compare_values(self) -> pd.DataFrame:
              """Compare dataset values."""
              if not self.by_vars:
                  # Compare all rows
                  merged = self.base_df.merge(
                      self.comp_df,
                      how='outer',
                      indicator=True
                  )
              else:
                  # Compare by specified variables
                  merged = self.base_df.merge(
                      self.comp_df,
                      on=self.by_vars,
                      how='outer',
                      indicator=True
                  )
              
              # Store comparison metrics
              self.matching_rows = (merged['_merge'] == 'both').sum()
              self.base_only_rows = (merged['_merge'] == 'left_only').sum()
              self.comp_only_rows = (merged['_merge'] == 'right_only').sum()
              
              # Compare values for matching rows
              if self.matching_rows > 0:
                  compare_vars = (self.compare_vars if self.compare_vars 
                                else list(set(self.base_df.columns) & 
                                        set(self.comp_df.columns)))
                  
                  differences = []
                  for var in compare_vars:
                      if var in merged.columns:
                          base_val = merged["_x".format(var)]
                          comp_val = merged["_y".format(var)]
                          diff_mask = base_val != comp_val
                          if diff_mask.any():
                              differences.append({
                                  'variable': var,
                                  'differences': diff_mask.sum(),
                                  'max_diff': (base_val - comp_val).abs().max()
                                  if pd.api.types.is_numeric_dtype(base_val) else None
                              })
                  
                  self.differing_values = len(differences)
                  return pd.DataFrame(differences)
              
              return pd.DataFrame() 

data_step_functions_additional:
  template: |
    class SASDataFunctions:
        # String Functions
        @staticmethod
        def substr(string: str, start: int, length: int = None) -> str:
            """SUBSTR function."""
            if start < 1:
                start = 1
            start = start - 1  # Convert to 0-based indexing
            if length is None:
                return string[start:]
            return string[start:start + length]
        
        @staticmethod
        def scan(string: str, n: int, delim: str = ' ') -> str:
            """SCAN function."""
            try:
                return string.split(delim)[n - 1]  # Convert to 0-based indexing
            except IndexError:
                return ''
        
        @staticmethod
        def trim(string: str) -> str:
            """TRIM function."""
            return string.strip()
        
        @staticmethod
        def left(string: str) -> str:
            """LEFT function."""
            return string.lstrip()
        
        @staticmethod
        def right(string: str) -> str:
            """RIGHT function."""
            return string.rstrip()
        
        # Date Functions
        @staticmethod
        def today() -> datetime:
            """TODAY function."""
            return datetime.now().date()
        
        @staticmethod
        def date() -> datetime:
            """DATE function."""
            return datetime.now()
        
        @staticmethod
        def mdy(month: int, day: int, year: int) -> datetime:
            """MDY function."""
            try:
                return datetime(year, month, day)
            except ValueError:
                return None
        
        @staticmethod
        def year(date_value: datetime) -> int:
            """YEAR function."""
            return date_value.year
        
        @staticmethod
        def month(date_value: datetime) -> int:
            """MONTH function."""
            return date_value.month
        
        @staticmethod
        def day(date_value: datetime) -> int:
            """DAY function."""
            return date_value.day
        
        # Numeric Functions
        @staticmethod
        def round(value: float, unit: float = 1) -> float:
            """ROUND function."""
            return round(value / unit) * unit
        
        @staticmethod
        def int(value: float) -> int:
            """INT function."""
            return int(np.floor(value))
        
        @staticmethod
        def ceil(value: float) -> int:
            """CEIL function."""
            return int(np.ceil(value))
        
        @staticmethod
        def floor(value: float) -> int:
            """FLOOR function."""
            return int(np.floor(value))
        
        @staticmethod
        def mod(dividend: float, divisor: float) -> float:
            """MOD function."""
            return dividend % divisor
        
        # Array Functions
        @staticmethod
        def dim(array: List) -> int:
            """DIM function."""
            return len(array)
        
        @staticmethod
        def hbound(array: List) -> int:
            """HBOUND function."""
            return len(array)
        
        @staticmethod
        def lbound(array: List) -> int:
            """LBOUND function."""
            return 1  # SAS arrays are 1-based 

format_extensions_complete:
  template: |
    class CompleteFormatting:
        # Time Formats
        @staticmethod
        def time(value: datetime, format: str = 'HHMM') -> str:
            """TIME format."""
            format_map = {
                'HHMM': '%H:%M',
                'HHMMSS': '%H:%M:%S',
                'HOUR': '%H',
                'MINUTE': '%M',
                'SECOND': '%S'
            }
            return value.strftime(format_map.get(format, '%H:%M'))
        
        # Custom Picture Formats
        @staticmethod
        def picture_format(value: Any, template: str) -> str:
            """Custom picture format."""
            try:
                return template.format(value)
            except:
                return str(value)
        
        # International Formats
        @staticmethod
        def nlnum(value: float, locale: str = 'en_US') -> str:
            """International number format."""
            import locale as loc
            try:
                loc.setlocale(loc.LC_ALL, locale)
                return loc.format_string('%.2f', value)
            finally:
                loc.setlocale(loc.LC_ALL, '')
        
        @staticmethod
        def nldate(value: datetime, locale: str = 'en_US') -> str:
            """International date format."""
            import locale as loc
            try:
                loc.setlocale(loc.LC_ALL, locale)
                return value.strftime('%x')
            finally:
                loc.setlocale(loc.LC_ALL, '')
        
        # Specialized Numeric Formats
        @staticmethod
        def comma(value: float, decimals: int = 0) -> str:
            """COMMA format."""
            return "{value:,.f}".format(decimals)
        
        @staticmethod
        def dollar(value: float, decimals: int = 2) -> str:
            """DOLLAR format."""
            return "${value:,.f}".format(decimals)
        
        @staticmethod
        def percent(value: float, decimals: int = 0) -> str:
            """PERCENT format."""
            return "{value*100:.f}%".format(decimals)

