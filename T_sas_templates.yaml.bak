# Add these data step operations
data_step_operations:
  merge:
    template: |
      # MERGE operation
      {{output_dataset}}_df = pd.merge(
          {{left_dataset}}_df,
          {{right_dataset}}_df,
          how='{{merge_type}}',
          on=[{{by_vars|join_quotes}}]
      )

  update:
    template: |
      # UPDATE operation
      def update_dataset(base_df, update_df, by_vars):
          """Update dataset values based on BY variables."""
          merged = pd.merge(
              base_df,
              update_df,
              on=by_vars,
              how='left',
              suffixes=('', '_update')
          )
          
          # Update values where update exists
          update_cols = [col for col in update_df.columns if col not in by_vars]
          for col in update_cols:
              merged[col] = merged[col + '_update'].fillna(merged[col])
          
          return merged.drop([col + '_update' for col in update_cols], axis=1)
      
      {{output_dataset}}_df = update_dataset(
          {{base_dataset}}_df,
          {{update_dataset}}_df,
          [{{by_vars|join_quotes}}]
      )

  array:
    template: |
      # Array operations
      class SASArray:
          def __init__(self, df, columns, name):
              self.df = df
              self.columns = columns
              self.name = name
              self.validate_columns()
          
          def validate_columns(self):
              missing = [col for col in self.columns if col not in self.df.columns]
              if missing:
                  raise ValueError("Columns not found: ".format(missing))
          
          def apply(self, func):
              """Apply function to all array elements."""
              for col in self.columns:
                  self.df[col] = self.df[col].apply(func)
          
          def sum(self):
              """Sum across array elements."""
              return self.df[self.columns].sum(axis=1)
          
          def mean(self):
              """Mean across array elements."""
              return self.df[self.columns].mean(axis=1)
      
      {{array_name}} = SASArray(
          {{dataset}}_df,
          [{{columns|join_quotes}}],
          '{{array_name}}'
      )

  do_loop:
    template: |
      # DO loop implementation
      {% if type == 'iterative' %}
      for {{var}} in range({{start}}, {{end}} + 1{% if by %}, {{by}}{% endif %}):
          {{body|indent(4)}}
      {% elif type == 'until' %}
      {{var}} = {{start}}
      while True:
          {{body|indent(4)}}
          if {{condition}}:
              break
          {{var}} += {% if by %}{{by}}{% else %}1{% endif %}
      {% elif type == 'while' %}
      {{var}} = {{start}}
      while {{condition}}:
          {{body|indent(4)}}
          {{var}} += {% if by %}{{by}}{% else %}1{% endif %}
      {% endif %}

  retain:
    template: |
      # RETAIN statement implementation
      class RetainedVariable:
          def __init__(self, initial_value=None):
              self.value = initial_value
          
          def update(self, new_value):
              if pd.notna(new_value):
                  self.value = new_value
              return self.value
      
      {% for var in retained_vars %}
      {{var}}_retained = RetainedVariable({{initial_values.get(var, 'None')}})
      {{dataset}}_df['{{var}}'] = {{dataset}}_df['{{var}}'].apply({{var}}_retained.update)
      {% endfor %}

sql_operations:
  subquery:
    template: |
      # Subquery operations
      def execute_subquery(main_df, sub_df, condition):
          """Execute a subquery operation."""
          if condition.get('type') == 'exists':
              return main_df[main_df['{{key}}'].isin(sub_df['{{sub_key}}'])]
          elif condition.get('type') == 'not_exists':
              return main_df[~main_df['{{key}}'].isin(sub_df['{{sub_key}}'])]
          return main_df

  set_operations:
    template: |
      # Set operations
      def perform_set_operation(left_df, right_df, operation):
          """Perform set operations between two dataframes."""
          if operation == 'union':
              return pd.concat([left_df, right_df]).drop_duplicates()
          elif operation == 'union_all':
              return pd.concat([left_df, right_df])
          elif operation == 'intersect':
              return pd.merge(left_df, right_df, how='inner')
          elif operation == 'except':
              return left_df[~left_df.isin(right_df).all(axis=1)]

  window_functions:
    template: |
      # Window function implementations
      def apply_window_function(df, func_type, partition_cols=None, order_cols=None):
          """Apply window functions similar to SAS."""
          if partition_cols:
              grouped = df.groupby(partition_cols)
              if func_type == 'lag':
                  return grouped.shift(1)
              elif func_type == 'lead':
                  return grouped.shift(-1)
              elif func_type == 'first':
                  return grouped.transform('first')
              elif func_type == 'last':
                  return grouped.transform('last')
          return df

  complex_joins:
    template: |
      # Handle complex join scenarios
      def perform_complex_join(left_df, right_df, join_type, conditions):
          """Execute complex join operations."""
          if join_type == 'full_outer':
              return pd.merge(left_df, right_df, how='outer', **conditions)
          elif join_type == 'cross':
              return pd.merge(left_df, right_df, how='cross')

error_handling:
  conversion_error:
    template: |
      class SASConversionError(Exception):
          """Custom exception for SAS conversion errors."""
          def __init__(self, message: str, sas_code: str, component_type: str):
              self.message = message
              self.sas_code = sas_code
              self.component_type = component_type
              super().__init__("{component_type} Error: {message}\nSAS Code: ".format(sas_code))

  logging_setup:
    template: |
      import logging
      from pathlib import Path
      
      def setup_conversion_logging(
          log_file: str = 'sas_conversion.log',
          level: str = 'INFO'
      ):
          """Setup logging for SAS conversion process."""
          log_dir = Path('logs')
          log_dir.mkdir(exist_ok=True)
          
          logging.basicConfig(
              level=getattr(logging, level.upper()),
              format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
              handlers=[
                  logging.FileHandler(log_dir / log_file),
                  logging.StreamHandler()
              ]
          )

datetime_formats:
  template: |
    from datetime import datetime, date, time
    
    class SASDateTimeFormatter:
        """Handle SAS datetime format conversions."""
        
        # SAS date formats mapping to Python
        DATE_FORMATS = {
            'DATE': '%Y-%m-%d',
            'DDMMYY': '%d%m%y',
            'MMDDYY': '%m%d%y',
            'YYMMDD': '%y%m%d',
            'DATETIME': '%Y-%m-%d %H:%M:%S',
            'TIME': '%H:%M:%S'
        }
        
        @staticmethod
        def format_date(value, sas_format: str) -> str:
            """Convert date value to specified SAS format."""
            py_format = SASDateTimeFormatter.DATE_FORMATS.get(
                sas_format.upper(),
                '%Y-%m-%d'
            )
            try:
                if isinstance(value, (date, datetime)):
                    return value.strftime(py_format)
                return datetime.strptime(str(value), '%Y-%m-%d').strftime(py_format)
            except Exception as e:
                return str(value)

macro_variable_handling:
  array_macro:
    template: |
      class MacroArray:
          """Handle array-like macro variables."""
          def __init__(self, name: str, size: int):
              self.name = name
              self.size = size
              self.values = [None] * size
          
          def set_value(self, index: int, value: Any):
              if 0 <= index < self.size:
                  self.values[index] = value
          
          def get_value(self, index: int) -> Any:
              if 0 <= index < self.size:
                  return self.values[index]
              return None

  indirect_reference:
    template: |
      def resolve_macro_reference(ref_name: str) -> str:
          """Resolve indirect macro variable references."""
          return globals().get(ref_name, "&".format(ref_name)) 

error_handling_extensions:
  template: |
    class SASValidationError(Exception):
        """Validation error for SAS components."""
        def __init__(self, message: str, component_type: str, details: Dict[str, Any]):
            self.message = message
            self.component_type = component_type
            self.details = details
            super().__init__("{component_type} Validation Error: ".format(message))

    class ValidationRules:
        @staticmethod
        def validate_dataset_name(name: str) -> bool:
            """Validate SAS dataset name."""
            pattern = re.compile(r'^[a-zA-Z_][a-zA-Z0-9_]*$')
            return bool(pattern.match(name))
            
        @staticmethod
        def validate_variable_name(name: str) -> bool:
            """Validate SAS variable name."""
            pattern = re.compile(r'^[a-zA-Z_][a-zA-Z0-9_]*$')
            max_length = 32
            return bool(pattern.match(name)) and len(name) <= max_length

macro_handling:
  scope_management:
    template: |
      class MacroScope:
          """Manage macro variable scoping."""
          def __init__(self):
              self.global_vars = 
              self.local_vars = 
              self.scope_stack = []

          def push_scope(self):
              """Create new local scope."""
              self.scope_stack.append(self.local_vars.copy())
              self.local_vars = 

          def pop_scope(self):
              """Restore previous scope."""
              if self.scope_stack:
                  self.local_vars = self.scope_stack.pop()

          def get_var(self, name: str) -> Any:
              """Get macro variable value."""
              return self.local_vars.get(name, self.global_vars.get(name))

      # Initialize macro scope
      macro_scope = MacroScope() 

output_handling:
  html_output:
    template: |
      def generate_html_report(df, title: str, filename: str):
          """Generate HTML report similar to ODS HTML."""
          import pandas as pd
          
          html_template = '''
          <html>
          <head>
              <title>{title}</title>
              <style>
                  table {{ border-collapse: collapse; width: 100%; }}
                  th, td {{ border: 1px solid black; padding: 8px; text-align: left; }}
                  th {{ background-color: #f2f2f2; }}
              </style>
          </head>
          <body>
              <h1>{title}</h1>
              {table}
          </body>
          </html>
          '''
          
          table_html = df.to_html(classes='dataframe')
          report_html = html_template.format(title=title, table=table_html)
          
          with open(filename, 'w') as f:
              f.write(report_html)

  pdf_output:
    template: |
      def generate_pdf_report(df, title: str, filename: str):
          """Generate PDF report similar to ODS PDF."""
          from reportlab.lib import colors
          from reportlab.lib.pagesizes import letter
          from reportlab.platypus import SimpleDocTemplate, Table, TableStyle
          
          doc = SimpleDocTemplate(filename, pagesize=letter)
          elements = []
          
          # Convert DataFrame to table data
          table_data = [df.columns.tolist()] + df.values.tolist()
          table = Table(table_data)
          table.setStyle(TableStyle([
              ('BACKGROUND', (0, 0), (-1, 0), colors.grey),
              ('TEXTCOLOR', (0, 0), (-1, 0), colors.whitesmoke),
              ('ALIGN', (0, 0), (-1, -1), 'CENTER'),
              ('FONTNAME', (0, 0), (-1, 0), 'Helvetica-Bold'),
              ('FONTSIZE', (0, 0), (-1, 0), 14),
              ('BOTTOMPADDING', (0, 0), (-1, 0), 12),
              ('BACKGROUND', (0, 1), (-1, -1), colors.beige),
              ('TEXTCOLOR', (0, 1), (-1, -1), colors.black),
              ('FONTNAME', (0, 1), (-1, -1), 'Helvetica'),
              ('FONTSIZE', (0, 1), (-1, -1), 12),
              ('GRID', (0, 0), (-1, -1), 1, colors.black)
          ]))
          elements.append(table)
          doc.build(elements) 

format_types:
  template: |
    class SASFormatters:
        @staticmethod
        def dollar_format(value, width=None, decimals=2):
            """Format as currency."""
            try:
                formatted = "${value:,.f}".format(decimals)
                if width:
                    return formatted.rjust(width)
                return formatted
            except:
                return str(value)
        
        @staticmethod
        def percent_format(value, decimals=0):
            """Format as percentage."""
            try:
                return "{value:.f}%".format(decimals)
            except:
                return str(value)
        
        @staticmethod
        def comma_format(value, decimals=0):
            """Format with commas."""
            try:
                return "{value:,.f}".format(decimals)
            except:
                return str(value)
        
        @staticmethod
        def datetime_format(value, format_str):
            """Format datetime values."""
            try:
                return value.strftime(format_str)
            except:
                return str(value) 

data_step_extensions:
  input_statement:
    template: |
      class InputParser:
          """Parse input data according to SAS formats."""
          def __init__(self, format_str: str):
              self.format = self._parse_format(format_str)
          
          def _parse_format(self, format_str: str) -> List[Dict]:
              """Parse SAS input format specification."""
              formats = []
              for spec in format_str.split():
                  if '@' in spec:
                      position, fmt = spec.split()
                      formats.append({
                          'position': int(position.replace('@', '')),
                          'format': fmt
                      })
                  else:
                      formats.append({'format': spec})
              return formats
          
          def parse_line(self, line: str) -> Dict[str, Any]:
              """Parse a line of input according to format."""
              values = 
              current_pos = 0
              
              for fmt in self.format:
                  if 'position' in fmt:
                      current_pos = fmt['position'] - 1
                  
                  # Extract value based on format
                  if '$' in fmt['format']:
                      # Character format
                      width = int(fmt['format'].replace('$', ''))
                      values['col_'.format(len(values))] = line[current_pos:current_pos+width].strip()
                  else:
                      # Numeric format
                      width = int(fmt['format'])
                      try:
                          values['col_'.format(len(values))] = float(line[current_pos:current_pos+width])
                      except:
                          values['col_'.format(len(values))] = None
                  
                  current_pos += width
              
              return values

  array_operations:
    template: |
      class SASArrayOperations:
          """Enhanced array operations."""
          def __init__(self, df: pd.DataFrame):
              self.df = df
              self.arrays = 
          
          def define_array(self, name: str, variables: List[str], dim: int = None):
              """Define a SAS-style array."""
              if dim and len(variables) != dim:
                  raise ValueError("Array dimension {dim} doesn't match number of variables ".format(len(variables)))
              
              self.arrays[name] = variables
          
          def array_operation(self, array_name: str, operation: str, *args, **kwargs):
              """Perform operation on array elements."""
              if array_name not in self.arrays:
                  raise ValueError("Array  not defined".format(array_name))
              
              variables = self.arrays[array_name]
              
              if operation == 'sum':
                  return self.df[variables].sum(axis=1)
              elif operation == 'mean':
                  return self.df[variables].mean(axis=1)
              elif operation == 'min':
                  return self.df[variables].min(axis=1)
              elif operation == 'max':
                  return self.df[variables].max(axis=1)
              elif operation == 'apply':
                  func = args[0] if args else kwargs.get('func')
                  if not func:
                      raise ValueError("Function required for apply operation")
                  return self.df[variables].apply(func) 

format_extensions:
  numeric_formats:
    template: |
      class NumericFormats:
          @staticmethod
          def best(value: float, width: int = 12) -> str:
              """BEST. format - choose best representation."""
              if abs(value) < 0.0001 or abs(value) > 1e7:
                  return "{value:.e}".format(width-7)
              return "{value:.f}".format(width-2).rstrip('0').rstrip('.')
          
          @staticmethod
          def hex(value: int, width: int = 8) -> str:
              """Hexadecimal format."""
              return "{value:0X}".format(width)
          
          @staticmethod
          def binary(value: int, width: int = 8) -> str:
              """Binary format."""
              return "{value:0b}".format(width)

  date_formats:
    template: |
      class DateFormats:
          @staticmethod
          def weekdate(date_value: datetime) -> str:
              """WEEKDATE format."""
              return date_value.strftime("%A, %B %d, %Y")
          
          @staticmethod
          def monyy(date_value: datetime) -> str:
              """MONYY format."""
              return date_value.strftime("%b%y").upper()
          
          @staticmethod
          def yyqc(date_value: datetime) -> str:
              """YYQC format."""
              quarter = (date_value.month - 1) // 3 + 1
              return "{date_value.strftime('%y')}Q".format(quarter) 

sql_window_functions:
  template: |
    class WindowFunctions:
        @staticmethod
        def rank(df: pd.DataFrame, partition_cols: List[str], order_cols: List[str]) -> pd.Series:
            """Implement RANK function."""
            return df.groupby(partition_cols)[order_cols].rank(method='min')
            
        @staticmethod
        def dense_rank(df: pd.DataFrame, partition_cols: List[str], order_cols: List[str]) -> pd.Series:
            """Implement DENSE_RANK function."""
            return df.groupby(partition_cols)[order_cols].rank(method='dense')
            
        @staticmethod
        def row_number(df: pd.DataFrame, partition_cols: List[str]) -> pd.Series:
            """Implement ROW_NUMBER function."""
            return df.groupby(partition_cols).cumcount() + 1
            
        @staticmethod
        def ntile(df: pd.DataFrame, partition_cols: List[str], n: int) -> pd.Series:
            """Implement NTILE function."""
            return df.groupby(partition_cols).apply(
                lambda x: pd.qcut(range(len(x)), n, labels=False) + 1
            ) 

data_step_functions:
  template: |
    class SASFunctions:
        @staticmethod
        def lag(series: pd.Series, n: int = 1) -> pd.Series:
            """Implement LAG function."""
            return series.shift(n)
            
        @staticmethod
        def dif(series: pd.Series, n: int = 1) -> pd.Series:
            """Implement DIF function."""
            return series - series.shift(n)
            
        @staticmethod
        def sum(series: pd.Series, reset_group: pd.Series = None) -> pd.Series:
            """Implement SUM function with optional reset condition."""
            if reset_group is None:
                return series.cumsum()
            return series.groupby(reset_group).cumsum() 

