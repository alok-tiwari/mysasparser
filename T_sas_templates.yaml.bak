---
# SAS to Python conversion templates

# Basic imports and setup
imports:
  template: |
    import pandas as pd
    import numpy as np
    from scipy import stats
    import os
    import matplotlib.pyplot as plt
    import seaborn as sns
    import re
    from typing import Any, List, Dict

proc_means:
  template: |
    {% if dataset %}
    # Calculate descriptive statistics for {{ dataset }}
    {% if variables %}
    stats_df = {{ dataset }}_df[{{ variables|join(', ') }}].describe()
    {% else %}
    stats_df = {{ dataset }}_df.describe()
    {% endif %}
    
    {% if maxdec %}
    pd.set_option('display.float_format', lambda x: '{:.{prec}f}'.format(x, prec=maxdec))
    {% endif %}
    
    print('\nDescriptive Statistics:')
    print(stats_df)
    {% endif %}

proc_freq:
  template: |
    # Enhanced frequency analysis
    from scipy import stats
    import numpy as np
    
    {% for table in tables %}
    {% if '*' in table %}
    {% set vars = table.split('*') %}
    # Cross-tabulation of {{vars|join(' by ')}}
    ctab = pd.crosstab({{dataset}}_df['{{vars[0]}}'], {{dataset}}_df['{{vars[1]}}'])
    
    print('\nCross-tabulation:')
    print(ctab)
    
    # Add row and column percentages
    print('\nRow Percentages:')
    print(pd.crosstab({{dataset}}_df['{{vars[0]}}'], {{dataset}}_df['{{vars[1]}}'], normalize='index') * 100)
    print('\nColumn Percentages:')
    print(pd.crosstab({{dataset}}_df['{{vars[0]}}'], {{dataset}}_df['{{vars[1]}}'], normalize='columns') * 100)
    
    {% if chisq %}
    # Chi-square test
    chi2, p_value, dof, expected = stats.chi2_contingency(ctab)
    print('\nChi-square test results:')
    print("Chi2 statistic: {:.4f}".format(chi2))
    print("p-value: {:.4f}".format(p_value))
    print('Degrees of freedom: '.format(dof))
    print('Significant at α=0.05: '.format(p_value < 0.05))
    
    # Fisher's exact test (for 2x2 tables)
    if ctab.shape == (2, 2):
        fisher_stat, fisher_p = stats.fisher_exact(ctab)
        print('\nFisher\'s Exact Test:')
        print('Odds ratio: {:.4f}'.format(fisher_stat))
        print('p-value: {:.4f}'.format(fisher_p))
    
    # Measures of association
    n = ctab.sum().sum()
    cramers_v = np.sqrt(chi2 / (n * min(ctab.shape[0]-1, ctab.shape[1]-1)))
    print('\nMeasures of Association:')
    print('Cramer\'s V: {:.4f}'.format(cramers_v))
    {% endif %}
    
    {% if cmh and strata_var %}
    # Cochran-Mantel-Haenszel test
    from statsmodels.stats.contingency_tables import StratifiedTable
    strata = {{dataset}}_df['{{strata_var}}'].unique()
    tables = [pd.crosstab(
        {{dataset}}_df[{{dataset}}_df['{{strata_var}}'] == s]['{{vars[0]}}'],
        {{dataset}}_df[{{dataset}}_df['{{strata_var}}'] == s]['{{vars[1]}}']
    ) for s in strata]
    
    cmh_result = StratifiedTable(tables).test_null_odds()
    print('\nCochran-Mantel-Haenszel Test:')
    print('Statistic: {:.4f}'.format(cmh_result.statistic))
    print('p-value: {:.4f}'.format(cmh_result.pvalue))
    {% endif %}
    
    {% else %}
    # Single variable frequency distribution
    freq = {{dataset}}_df['{{table}}'].value_counts()
    pct = {{dataset}}_df['{{table}}'].value_counts(normalize=True) * 100
    freq_df = pd.DataFrame({
        'Frequency': freq,
        'Percentage': pct,
        'Cumulative Freq': freq.cumsum(),
        'Cumulative Pct': pct.cumsum()
    })
    print('\nFrequency Distribution for {{table}}:')
    print(freq_df)
    {% endif %}
    {% endfor %}

proc_freq_extensions:
  template: |
    # Additional statistical measures for PROC FREQ
    def calculate_risk_ratios(table):
        """Calculate risk ratios and odds ratios."""
        if table.shape != (2, 2):
            return None
            
        a = table.iloc[0,0]  # exposed, outcome
        b = table.iloc[0,1]  # exposed, no outcome
        c = table.iloc[1,0]  # unexposed, outcome
        d = table.iloc[1,1]  # unexposed, no outcome
        
        # Risk ratio
        risk_exposed = a / (a + b)
        risk_unexposed = c / (c + d)
        risk_ratio = risk_exposed / risk_unexposed
        
        # Odds ratio
        odds_ratio = (a * d) / (b * c)
        
        return {
            'risk_ratio': risk_ratio,
            'odds_ratio': odds_ratio,
            'risk_exposed': risk_exposed,
            'risk_unexposed': risk_unexposed
        }

    def calculate_trend_test(table):
        """Cochran-Armitage trend test."""
        from scipy.stats import norm
        
        scores = np.arange(table.shape[1])
        n_i = table.sum(axis=1)
        p_i = np.sum(scores * table.T / n_i, axis=1)
        p_0 = np.sum(scores * table.sum(axis=0)) / np.sum(n_i)
        
        # Calculate test statistic
        numerator = np.sum(n_i * (p_i - p_0))
        denominator = np.sqrt(np.sum(n_i * (p_i - p_0)**2))
        z_stat = numerator / denominator
        p_value = 2 * (1 - norm.cdf(abs(z_stat)))
        
        return z_stat, p_value

proc_sort:
  template: |
    {% if dataset %}
    # Sort {{ dataset }}
    {% if by_vars %}
    {{ dataset }}_df = {{ dataset }}_df.sort_values(
        by=[{{ by_vars|join(', ') }}],
        {% if ascending is defined %}ascending={{ ascending }}{% endif %}
    )
    
    {% if nodupkey %}
    {{ dataset }}_df = {{ dataset }}_df.drop_duplicates(subset=[{{ by_vars|join(', ') }}])
    {% endif %}
    
    {% if nodup %}
    {{ dataset }}_df = {{ dataset }}_df.drop_duplicates()
    {% endif %}
    {% endif %}
    {% endif %}

proc_univariate:
  template: |
    {% if dataset and variables %}
    # Univariate analysis for {{ dataset }}
    from scipy import stats
    
    {% for var in variables %}
    print("\nUnivariate analysis for {{ var }}:")
    data = {{ dataset }}_df['{{ var }}'].dropna()
    
    # Basic statistics
    desc = data.describe()
    print("\nDescriptive statistics:")
    print(desc)
    
    # Additional statistics
    print("\nAdditional statistics:")
    print("Skewness: {:.4f}".format(stats.skew(data)))
    print("Kurtosis: {:.4f}".format(stats.kurtosis(data)))
    
    {% if plots %}
    # Plots
    import matplotlib.pyplot as plt
    
    plt.figure(figsize=(12, 4))
    
    # Histogram
    plt.subplot(131)
    data.hist(bins=30)
    plt.title('Histogram')
    
    # Box plot
    plt.subplot(132)
    plt.boxplot(data)
    plt.title('Box Plot')
    
    # Q-Q plot
    plt.subplot(133)
    stats.probplot(data, dist="norm", plot=plt)
    plt.title('Q-Q Plot')
    
    plt.tight_layout()
    plt.show()
    {% endif %}
    {% endfor %}
    {% endif %}

proc_ttest:
  template: |
    # Enhanced t-test analysis
    from scipy import stats
    import numpy as np
    
    {% if one_sample %}
    # One-sample t-test
    data = {{dataset}}_df['{{var}}'].dropna()
    mean = np.mean(data)
    std = np.std(data, ddof=1)
    n = len(data)
    std_err = std / np.sqrt(n)
    
    # Calculate t-statistic and p-value
    t_stat, p_value = stats.ttest_1samp(data, {{mu0}})
    
    # Calculate confidence interval
    t_crit = stats.t.ppf(0.975, df=n-1)  # 95% CI
    ci_lower = mean - t_crit * std_err
    ci_upper = mean + t_crit * std_err
    
    print('\nOne-Sample T-Test Results:')
    print('Variable: {{var}}')
    print('N: '.format(n))
    print('Mean: {:.4f}'.format(mean))
    print('Std Dev: {:.4f}'.format(std))
    print('Std Err: {:.4f}'.format(std_err))
    print('t-statistic: {:.4f}'.format(t_stat))
    print('p-value: {:.4f}'.format(p_value))
    print('95% CI: ({:.4f}, {:.4f})'.format(ci_lower, ci_upper))
    
    {% elif paired %}
    # Paired t-test
    var1_data = {{dataset}}_df['{{var1}}'].dropna()
    var2_data = {{dataset}}_df['{{var2}}'].dropna()
    
    # Calculate paired differences
    diff = var1_data - var2_data
    mean_diff = np.mean(diff)
    std_diff = np.std(diff, ddof=1)
    n = len(diff)
    std_err = std_diff / np.sqrt(n)
    
    t_stat, p_value = stats.ttest_rel(var1_data, var2_data)
    
    # Calculate confidence interval for difference
    t_crit = stats.t.ppf(0.975, df=n-1)
    ci_lower = mean_diff - t_crit * std_err
    ci_upper = mean_diff + t_crit * std_err
    
    print('\nPaired T-Test Results:')
    print('Variables: {{var1}} - {{var2}}')
    print('N: '.format(n))
    print('Mean Difference: {:.4f}'.format(mean_diff))
    print('Std Dev: {:.4f}'.format(std_diff))
    print('Std Err: {:.4f}'.format(std_err))
    print('t-statistic: {:.4f}'.format(t_stat))
    print('p-value: {:.4f}'.format(p_value))
    print('95% CI: ({:.4f}, {:.4f})'.format(ci_lower, ci_upper))
    
    {% else %}
    # Independent t-test
    group1 = {{dataset}}_df[{{dataset}}_df['{{group_var}}'] == {{group1_value}}]['{{var}}'].dropna()
    group2 = {{dataset}}_df[{{dataset}}_df['{{group_var}}'] == {{group2_value}}]['{{var}}'].dropna()
    
    # Calculate statistics
    mean1 = np.mean(group1)
    mean2 = np.mean(group2)
    std1 = np.std(group1, ddof=1)
    std2 = np.std(group2, ddof=1)
    n1 = len(group1)
    n2 = len(group2)
    
    # Perform t-test
    equal_var = {{equal_var|default(True)}}
    t_stat, p_value = stats.ttest_ind(group1, group2, equal_var=equal_var)
    
    # Calculate confidence interval
    if equal_var:
        # Pooled standard error
        df = n1 + n2 - 2
        pooled_var = ((n1-1) * std1**2 + (n2-1) * std2**2) / df
        std_err = np.sqrt(pooled_var * (1/n1 + 1/n2))
    else:
        # Welch-Satterthwaite
        std_err = np.sqrt(std1**2/n1 + std2**2/n2)
        df = (std1**2/n1 + std2**2/n2)**2 / ((std1**2/n1)**2/(n1-1) + (std2**2/n2)**2/(n2-1))
    
    t_crit = stats.t.ppf(0.975, df=df)
    ci_lower = (mean1 - mean2) - t_crit * std_err
    ci_upper = (mean1 - mean2) + t_crit * std_err
    
    print('\nIndependent T-Test Results:')
    print('Variable: {{var}}')
    print('Group 1: , N='.format({{group1_value}}, n1))
    print('Group 2: , N='.format({{group2_value}}, n2))
    print('Mean 1: {:.4f}'.format(mean1))
    print('Mean 2: {:.4f}'.format(mean2))
    print('Std Dev 1: {:.4f}'.format(std1))
    print('Std Dev 2: {:.4f}'.format(std2))
    print('t-statistic: {:.4f}'.format(t_stat))
    print('p-value: {:.4f}'.format(p_value))
    print('95% CI: ({:.4f}, {:.4f})'.format(ci_lower, ci_upper))
    {% endif %}

proc_reg:
  template: |
    {% if dataset and dependent and independent %}
    # Linear regression analysis
    from sklearn.linear_model import LinearRegression
    from sklearn.metrics import r2_score, mean_squared_error
    import numpy as np
    
    X = {{ dataset }}_df[[{{ independent|join(', ') }}]]
    y = {{ dataset }}_df['{{ dependent }}']
    
    model = LinearRegression()
    model.fit(X, y)
    
    # Print results
    print("\nRegression Results:")
    print("\nCoefficients:")
    for var, coef in zip([{{ independent|join(', ') }}], model.coef_):
        print(": {:.4f}".format(var, coef))
    print("\nIntercept: {:.4f}".format(model.intercept_))
    print("R-squared: {:.4f}".format(model.score(X, y)))
    
    # Predictions and residuals
    y_pred = model.predict(X)
    residuals = y - y_pred
    
    {% if plots %}
    import matplotlib.pyplot as plt
    
    plt.figure(figsize=(12, 4))
    
    # Actual vs Predicted
    plt.subplot(121)
    plt.scatter(y, y_pred)
    plt.plot([y.min(), y.max()], [y.min(), y.max()], 'r--')
    plt.xlabel('Actual')
    plt.ylabel('Predicted')
    plt.title('Actual vs Predicted')
    
    # Residual plot
    plt.subplot(122)
    plt.scatter(y_pred, residuals)
    plt.axhline(y=0, color='r', linestyle='--')
    plt.xlabel('Predicted')
    plt.ylabel('Residuals')
    plt.title('Residual Plot')
    
    plt.tight_layout()
    plt.show()
    {% endif %}
    {% endif %}

proc_corr:
  template: |
    {% if dataset and variables %}
    # Correlation analysis for {{ dataset }}
    corr_df = {{ dataset }}_df[[{{ variables|join(', ') }}]].corr()
    
    print("\nCorrelation Matrix:")
    print(corr_df)
    
    {% if plots %}
    import seaborn as sns
    import matplotlib.pyplot as plt
    
    plt.figure(figsize=(10, 8))
    sns.heatmap(corr_df, annot=True, cmap='coolwarm', center=0)
    plt.title('Correlation Heatmap')
    plt.show()
    {% endif %}
    {% endif %}

data_step:
  template: |
    {% if output_dataset %}
    # Create new dataset {{ output_dataset }}
    {% if input_dataset %}
    {{ output_dataset }}_df = {{ input_dataset }}_df.copy()
    {% else %}
    {{ output_dataset }}_df = pd.DataFrame()
    {% endif %}
    
    {% if where_clause %}
    {{ output_dataset }}_df = {{ output_dataset }}_df[{{ where_clause }}]
    {% endif %}
    
    {% if assignments %}
    {% for assignment in assignments %}
    {{ output_dataset }}_df['{{ assignment.variable }}'] = {{ assignment.expression }}
    {% endfor %}
    {% endif %}
    {% endif %}

  by_group_processing:
    template: |
      class ByGroupProcessor:
          def __init__(self, df, by_vars):
              self.df = df
              self.by_vars = by_vars
              self.grouped = df.groupby(by_vars)
              self._first = self._create_first_last_flags('first')
              self._last = self._create_first_last_flags('last')
          
          def _create_first_last_flags(self, flag_type):
              """Create FIRST. and LAST. flags for BY groups."""
              if flag_type == 'first':
                  return self.grouped.cumcount() == 0
              else:
                  return self.grouped.cumcount() == (self.grouped.size() - 1)
          
          def process(self, func):
              """Process data by group."""
              return self.grouped.apply(func)
          
          @property
          def first(self):
              """Get FIRST. flag for current observation."""
              return self._first
          
          @property
          def last(self):
              """Get LAST. flag for current observation."""
              return self._last

  infile:
    template: |
      class InfileReader:
          def __init__(self, file_path, **options):
              self.file_path = file_path
              self.options = options
              
          def read(self):
              """Read external file based on options."""
              if self.options.get('delimiter') == ' ':
                  # Fixed-width file
                  return pd.read_fwf(
                      self.file_path,
                      widths=self.options.get('widths'),
                      names=self.options.get('names')
                  )
              else:
                  # Delimited file
                  return pd.read_csv(
                      self.file_path,
                      sep=self.options.get('delimiter', ','),
                      names=self.options.get('names'),
                      skiprows=self.options.get('skiprows', 0)
                  )

proc_sql:
  template: |
    {% if statements %}
    {% for stmt in statements %}
    {% if stmt.type == 'select' %}
    result_df = {{ stmt.from_table }}_df.copy()
    
    {% if stmt.where %}
    result_df = result_df[{{ stmt.where }}]
    {% endif %}
    
    {% if stmt.columns %}
    result_df = result_df[{{ stmt.columns|join(', ') }}]
    {% endif %}
    
    {% if stmt.order_by %}
    result_df = result_df.sort_values(
        by={{ stmt.order_by.columns|join(', ') }},
        ascending={{ stmt.order_by.ascending|default(True) }}
    )
    {% endif %}
    {% endif %}
    {% endfor %}
    {% endif %}
libname:
  template: |
    # Library definition for {{ libname }}
    {{ libname }}_path = "{{ path }}"
    {% if options %}
    # Options: {{ options|join(', ') }}
    {% endif %}
    
    if not os.path.exists({{ libname }}_path):
        os.makedirs({{ libname }}_path)

filename:
  template: |
    # File reference for {{ fileref }}
    {{ fileref }}_path = "{{ path }}"
    {% if options %}
    # Options: {{ options|join(', ') }}
    {% endif %}

# Global Settings
options:
  template: |
    # SAS Global Options
    import pandas as pd
    import numpy as np
    
    # Set display options
    pd.set_option('display.max_rows', {{ max_rows|default(None) }})
    pd.set_option('display.max_columns', {{ max_columns|default(None) }})
    {% if format %}
    pd.set_option('display.float_format', lambda x: '{{ format }}'.format(x))
    {% endif %}

# Macro System
macro_variable:
  template: |
    # Define macro variable {{ name }}
    {{ name }} = {{ value }}
    {% if global %}
    globals()['{{ name }}'] = {{ value }}
    {% endif %}

macro_definition:
  template: |
    def {{ name }}({{ parameters|join(', ') }}):
        """{{ description|default('SAS Macro Implementation') }}"""
        {% if error_handling %}
        try:
        {% endif %}
            {{ content|indent(4) }}
        {% if error_handling %}
        except Exception as e:
            print("Error in macro : ".format(name, str(e)))
            return None
        {% endif %}

# Graphics System
graphics_setup:
  template: |
    import matplotlib.pyplot as plt
    import seaborn as sns
    
    # Reset graphics settings
    plt.rcdefaults()
    
    # Set style and figure size
    plt.style.use('{{ style|default("default") }}')
    plt.figure(figsize=({{ width|default(10) }}, {{ height|default(6) }}))

title_footnote:
  template: |
    {% if title %}
    plt.title("{{ title }}")
    {% endif %}
    
    {% if footnote %}
    plt.figtext(0.99, 0.01, "{{ footnote }}", 
                horizontalalignment='right', 
                style='italic', 
                size=8)
    {% endif %}

axis_definition:
  template: |
    # Axis settings for {{ axis_name }}
    plt.{{ axis }}axis(
        label="{{ label }}",
        {% if limits %}
        limits=[{{ limits|join(', ') }}],
        {% endif %}
        {% if ticks %}
        ticks=[{{ ticks|join(', ') }}],
        {% endif %}
    )

proc_gchart:
  template: |
    {% if dataset and chart_type %}
    # Create {{ chart_type }} chart
    plt.figure(figsize=({{ width|default(10) }}, {{ height|default(6) }}))
    
    {% if chart_type == 'vbar' %}
    sns.barplot(
        data={{ dataset }}_df,
        x='{{ x_var }}',
        y='{{ y_var }}'
        {% if group %}, hue='{{ group }}'{% endif %}
        {% if stat %}, estimator='{{ stat }}'{% endif %}
    )
    {% endif %}
    
    plt.xticks(rotation={{ rotation|default(45) }})
    plt.tight_layout()
    {% endif %}

# Format System
proc_format:
  template: |
    # Create format dictionary for {{ format_name }}
    {{ format_name }}_format = {
    {% for range, label in ranges.items() %}
        {{ range }}: "{{ label }}"{% if not loop.last %},{% endif %}
    {% endfor %}
    }
    
    {% if apply_to %}
    # Apply format to data
    {{ dataset }}_df['{{ apply_to }}'] = {{ dataset }}_df['{{ apply_to }}'].map({{ format_name }}_format)
    {% endif %}

# Hash Table Operations
hash_table:
  template: |
    # Create hash table (lookup dictionary)
    {{ hash_name }}_lookup = {{ dataset }}_df.set_index('{{ key_var }}')
    
    {% if data_vars %}
    {{ hash_name }}_lookup = {{ hash_name }}_lookup[{{ data_vars|join(', ') }}].to_dict('index')
    {% endif %}
    
    def lookup_{{ hash_name }}(key):
        """Lookup values in {{ hash_name }} hash table."""
        return {{ hash_name }}_lookup.get(key, None)

# ODS Output
ods:
  template: |
    # ODS output configuration
    import matplotlib.pyplot as plt
    {% if style %}
    plt.style.use('{{ style }}')
    {% endif %}
    
    {% if path %}
    output_path = "{{ path }}"
    if not os.path.exists(output_path):
        os.makedirs(output_path)
    {% endif %}    
    {% if format == 'html' %}
    from IPython.display import HTML
    {% endif %}

# Add more templates for other PROC types...

proc_print:
  template: |
    # Display dataset contents
    {% if variables %}
    display_cols = [{{variables|join_quotes}}]
    print('\nDataset Contents (Selected Columns):')
    print({{dataset}}_df[display_cols]{% if nobs %}.head({{nobs}}){% endif %})
    {% else %}
    print('\nDataset Contents:')
    print({{dataset}}_df{% if nobs %}.head({{nobs}}){% endif %})
    {% endif %}
    
    {% if summary %}
    print('\nDataset Summary:')
    print({{dataset}}_df.info())
    {% endif %}

proc_report:
  template: |
    # Generate detailed report
    import pandas as pd
    from typing import Any, Dict
    
    class ReportBuilder:
        def __init__(self, data: pd.DataFrame):
            self.data = data.copy()
            self.compute_funcs = 
            self.breaks = []
            self.summaries = 
        
        def add_compute_block(self, name: str, func: Callable):
            self.compute_funcs[name] = func
        
        def add_break(self, var: str, summary_funcs: Dict[str, str]):
            self.breaks.append(var)
            self.summaries[var] = summary_funcs
        
        def generate(self) -> pd.DataFrame:
            result = self.data.copy()
            
            # Apply compute blocks
            for col, func in self.compute_funcs.items():
                result[col] = result.apply(func, axis=1)
            
            # Handle breaks and summaries
            if self.breaks:
                groups = result.groupby(self.breaks)
                for var, funcs in self.summaries.items():
                    summary = groups.agg(funcs)
                    # Add summary rows
                    result = pd.concat([result, summary])
            
            return result
    
    # Initialize report
    report = ReportBuilder({{dataset}}_df)
    
    {% if compute_blocks %}
    # Add compute blocks
    {% for block in compute_blocks %}
    report.add_compute_block('{{block.name}}', lambda row: {{block.computation}})
    {% endfor %}
    {% endif %}
    
    {% if breaks %}
    # Add breaks and summaries
    {% for break in breaks %}
    report.add_break('{{break.var}}', {{break.summaries}})
    {% endfor %}
    {% endif %}
    
    # Generate and display report
    result_df = report.generate()
    
    {% if order_vars %}
    result_df = result_df.sort_values([{{order_vars|join_quotes}}])
    {% endif %}
    
    print('\nDetailed Report:')
    print(result_df{% if nobs %}.head({{nobs}}){% endif %})

proc_format:
  template: |
    class Format:
        def __init__(self, name: str):
            self.name = name
            self.value_map = 
            self.ranges = []
            self.picture_spec = None
            
        def add_value(self, value: Any, label: str):
            self.value_map[value] = label
            
        def add_range(self, start: float, end: float, label: str):
            self.ranges.append((start, end, label))
            
        def set_picture(self, spec: str):
            self.picture_spec = spec
            
        def format_value(self, value: Any) -> str:
            if self.picture_spec:
                return '{value:{}}'.format(self.picture_spec)
            
            if self.ranges:
                for start, end, label in self.ranges:
                    if start <= value <= end:
                        return label
                        
            return self.value_map.get(value, str(value))
    
    # Create format
    {{format_name}} = Format('{{format_name}}')
    
    {% if values %}
    # Add individual values
    {% for value, label in values.items() %}
    {{format_name}}.add_value({{value}}, {{label|repr}})
    {% endfor %}
    {% endif %}
    
    {% if ranges %}
    # Add ranges
    {% for range in ranges %}
    {{format_name}}.add_range({{range.start}}, {{range.end}}, {{range.label|repr}})
    {% endfor %}
    {% endif %}
    
    {% if picture %}
    # Set picture specification
    {{format_name}}.set_picture('{{picture}}')
    {% endif %}

